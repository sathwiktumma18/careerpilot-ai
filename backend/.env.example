# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Database ---
# SQLite by default (zero-config local dev). For Postgres, uncomment:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/careerpilot
# DATABASE_URL=sqlite:///./data/careerpilot.db

# --- Environment ---
# ENVIRONMENT=development

# --- Auth (JWT) ---
# REQUIRED in production — a leaked/default secret lets anyone forge tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI providers (free tier) ---
# Primary LLM — get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local Ollama fallback (no key needed, but Ollama must be running)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Live jobs (JSearch on RapidAPI, free tier ≈100 req/mo) ---
# Register at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and paste
# the key. Leave blank to keep Job Match on the curated corpus.
# JSEARCH_API_KEY=
# JSEARCH_API_HOST=jsearch.p.rapidapi.com
# JSEARCH_MAX_AGE_DAYS=28

# --- Social sign-in (optional) ---
# Leave blank to disable a provider — the login/signup button then shows
# "coming soon" and /api/auth/oauth/{provider}/authorize returns 501.
# Register credentials + redirect URIs (see docs/DEPLOYMENT.md → "OAuth setup"):
#   Google : OAuth client  → redirect URI http://localhost:8000/api/auth/oauth/google/callback
#   GitHub : OAuth App     → callback      http://localhost:8000/api/auth/oauth/github/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Base of the redirect URI above — change in production (e.g. https://api.yourdomain.com)
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000
