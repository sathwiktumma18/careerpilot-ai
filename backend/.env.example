# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Database ---
# SQLite by default (zero-config local dev). For Postgres, uncomment:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/careerpilot
# DATABASE_URL=sqlite:///./data/careerpilot.db

# --- Environment ---
# ENVIRONMENT=development

# --- AI providers (free tier) ---
# Primary LLM — get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local Ollama fallback (no key needed, but Ollama must be running)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
